        int w, h;
        clear_terminal(); // Clears the terminal
        int running = 1;
        window_length(&w, &h); // Displays the dimensions
        draw(w, h);
        center_mouse();
        while (running) {
                nano_sleep(16);
        }

        restore_terminal();
        return 0;
