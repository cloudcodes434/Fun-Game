void _p_str(const char *s, int len) {
        if (len <= 0 || !s)
                return;
        __asm__ volatile("movq  $1, %%rax\n\t"
                         "movq  $1, %%rdi\n\t"
                         "syscall\n\t"
                         :
                         : "S"(s), "d"((long)len)
                         : "rax", "rdi", "rcx", "r11", "memory");
}

void _p_int(int val) {
        char buf[20];
        char *p = &buf[19];
        *p = '\n';

        if (val == 0) {
                *--p = '0';
        } else {
                do {
                        *--p = (char)((val % 10) + '0');
                        val /= 10;
                } while (val > 0);

                if (p >= buf && p <= &buf[20]) {
                        int len = (int)(&buf[20] - p);
                        _p_str(p, len);
                } else {
                        _p_str("[ERR: Buffer out of bounds]\n", 28);
                }
        }
}

void _p_int_raw(int val) {
        char buf[20];
        char *p = &buf[19];

        if (val == 0) {
                *--p = '0';
        }
        do {
                *--p = (char)((val % 10) + '0');
                val /= 10;
        } while (val > 0);
        if (p >= buf && p <= &buf[20]) {
                int len = (int)(&buf[20] - p);
                _p_str(p, len);
        } else {
                _p_str("ERR: Bufffer out of bounds]\n", 28);
        }
}


