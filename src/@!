void draw_map(int term_w, int term_h) {
        int row = 30;
        int col = 70;
	
	//TODO figure out why the for loops are  unoptimized	

        for (int i = 0; i < row; i++) { // inner
                center_cursor(term_w, term_h, row, col, i);
                for (int j = 0; j < col; j++) { // outer
                        if (i == 0 || i == row - 1 || j == 0 || j == col - 1) {
                                _p_str("#", 1);
                        } else {
                                _p_str(" ", 1);
                        }
                }

                _p_str("\n", 1);
        }
        move_cursor(term_h / 2, term_w / 2);
}

