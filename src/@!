int main(void) {
        int w, h;
        int last_w = -1, last_h = -1;
        clear_terminal(); // Clears the terminal
        int running = 1;
        window_length(&w, &h); // Displays the dimensions
        while (running) {

                window_length(&w, &h);
                if (w != last_w || h != last_h) {
                        clear_terminal();
                        draw(w, h);

                        last_w = w;
                        last_h = h;
                }

                draw_map(w, h);

                Player(w, h);

                nano_sleep(16);
        }

        restore_terminal();
        return 0;
}
